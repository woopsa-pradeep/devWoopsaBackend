    "Field Descriptions": {
      "ItemNumber": {
        "type": "number",
        "required": true,
        "description": "The item number from Inventory table"
      },
      "quantity": {
        "type": "integer",
        "required": true,
        "min": 1,
        "description": "Minimum quantity required to get the discount"
      },
      "discountType": {
        "type": "string",
        "required": true,
        "values": ["flat", "percentage"],
        "description": "Type of discount - 'flat' for fixed amount, 'percentage' for percentage off"
      },
      "discountValue": {
        "type": "number (decimal)",
        "required": true,
        "min": 0,
        "precision": 2,
        "description": "Discount value - if flat, it's the amount; if percentage, it's the percentage (e.g., 15.50 for 15.5%)"
      },
      "startDate": {
        "type": "date (YYYY-MM-DD)",
        "required": true,
        "description": "Start date when the discount becomes active"
      },
      "endDate": {
        "type": "date (YYYY-MM-DD)",
        "required": true,
        "description": "End date when the discount expires (must be after startDate)"
      },
      "isActive": {
        "type": "boolean",
        "required": false,
        "default": true,
        "description": "Whether the discount is currently active"
      }
    },

